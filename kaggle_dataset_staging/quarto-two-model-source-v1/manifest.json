{
  "architecture_and_privacy": {
    "chat_contexts": "Each llm.prompt call is wrapped in a fresh kbench.chats.new(..., orphan=True) context; no cross-player conversation history is shared.",
    "correction_attempts": 0,
    "engine_or_core_changes": "No Quarto Engine rules or state transitions changed. Phase 0 accepts an optional restricted source-ID mapping and exposes its public-UUID crosswalk only through restricted evaluator data; public observations and audit schemas remain unchanged.",
    "observation_boundary": "AgentAdapter validates exact nested public/requester-private observation schemas, requires the private requester marker to match public current_player and the embedded public state, then serializes a fixed allowlisted public projection plus the acting player's private payload. Public match entities use opaque, per-match UUIDv4 identifiers with piece-independent presentation order.",
    "public_result": "Task output uses an explicit public replay schema version 1 projection: match_id, mode, starting_player, board, public_history, and result. Restricted evaluator data, engine mappings, legal-action metadata, and Decision Traces are omitted.",
    "restricted_output": "Public Task output uses the allowlisted replay projection only. The source-ID/public-UUID crosswalk is stored only in restricted evaluator data and is never returned with the public result.",
    "runner_injection": "The Task resolves exact Gemini and Claude model identities and injects those identity strings as TournamentRunner tags; deterministic fake agents are used only by local offline tests."
  },
